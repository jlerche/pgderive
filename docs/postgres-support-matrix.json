  "features": [
    {
      "id": "native-codecs",
      "status": "bounded",
      "domain": "Source OIDs listed below; native widths, UUID, UTF8 text/varchar, timestamp/timestamptz and bounded exact numeric. Codec availability does not enable every relational position.",
      "implementation": [
        "src/source/contract.rs",
        "src/compiler/value.rs",
        "src/numeric.rs",
        "src/temporal.rs"
      ],
      "qualification": [
        "scripts/native_compiler_harness.py",
        "scripts/projection_compiler_harness.py"
      ]
    },
    {
      "id": "scalar-functions",
      "status": "bounded",
      "domain": "Only scalar_functions signatures and declared coercions. Strict NULL propagation after eager argument evaluation. CASE/COALESCE remain lazy. Integer overflow, expansion budgets and invalid code points fail without publication.",
      "implementation": [
        "src/compiler/capabilities.rs",
        "src/compiler/typed.rs",
        "src/compiler/typed/functions/strings.rs"
      ],
      "qualification": [
        "scripts/postgres_support_harness.py",
        "scripts/functions_compiler_harness.py",
        "src/worker/tests/engine_expressions.rs"
      ]
    },
    {
      "id": "arithmetic-and-casts",
      "status": "bounded",
      "domain": "Checked integral and bounded exact numeric +,-,*. Supported casts and predicates only; no generic PostgreSQL coercion engine. Numeric division and additional overloads reject.",
      "implementation": [
        "src/compiler/typed.rs",
        "src/compiler/capabilities.rs"
      ],
      "qualification": [
        "scripts/projection_compiler_harness.py",
        "scripts/circuit_numeric_harness.py"
      ]
    },
    {
      "id": "time-instants",
      "status": "bounded",
      "domain": "Microsecond timestamp/timestamptz values, BC/infinities and stored instant normalization. UTC execution; bounded fixed-duration offsets/date_bin. No named-zone conversion, DST calendar arithmetic, month bins or formatting.",
      "implementation": [
        "src/temporal.rs",
        "src/compiler/scalar.rs"
      ],
      "qualification": [
        "scripts/native_compiler_harness.py",
        "scripts/date_bin_compiler_harness.py",
        "scripts/postgres_support_harness.py"
      ]
    },
    {
      "id": "joins",
      "status": "bounded",
      "domain": "Declared equijoins, CROSS/self/multiway, bounded LEFT and restricted EXISTS/NOT EXISTS. SQL NULL matching and complete tuple multiplicity; simultaneous-input cross term. Computed key families and ON scopes follow sql-compiler.md.",
      "implementation": [
        "src/compiler/bind/native_join.rs",
        "src/compiler/left_join.rs",
        "src/compiler/bind/membership.rs"
      ],
      "qualification": [
        "scripts/query_native_join_harness.py",
        "scripts/computed_join_harness.py",
        "scripts/join_composition_harness.py",
        "src/engine/dataflow/tests/join.rs"
      ]
    },
    {
      "id": "grouping-and-distinct",
      "status": "bounded",
      "domain": "NULL groups, duplicates, retractions, group-only membership and accepted computed DISTINCT/grouping compositions. Full tuples remain weighted identities.",
      "implementation": [
        "src/compiler/partition.rs",
        "src/compiler/bind/membership.rs"
      ],
      "qualification": [
        "scripts/group_membership_harness.py",
        "scripts/composition_matrix_harness.py"
      ]
    },
    {
      "id": "aggregates",
      "status": "bounded",
      "domain": "COUNT, supported SUM/AVG/MIN/MAX, FILTER and bounded distinct-membership forms. Empty/all-NULL rules, exact intermediate statistics and result-width/scale bounds; not every PostgreSQL aggregate/type combination.",
      "implementation": [
        "src/compiler/partition.rs",
        "src/numeric.rs"
      ],
      "qualification": [
        "scripts/numeric_compiler_harness.py",
        "scripts/circuit_numeric_harness.py",
        "scripts/aggregate_inputs_compiler_harness.py"
      ]
    },
    {
      "id": "windows-and-navigation",
      "status": "bounded",
      "domain": "Declared ROWS/RANGE/GROUPS frames, rank/row_number/top-k and bounded lag/lead/lookup. Peer and physical occurrence identity differ. Explicit order proofs, frame forms, offsets and resource bounds in sql-compiler.md.",
      "implementation": [
        "src/compiler/partition.rs",
        "src/compiler/topk.rs",
        "src/compiler/navigation.rs",
        "src/compiler/lookup.rs"
      ],
      "qualification": [
        "scripts/sliding_window_harness.py",
        "scripts/peer_frames_compiler_harness.py",
        "scripts/navigation_compiler_harness.py",
        "scripts/lookup_compiler_harness.py"
      ]
    },
    {
      "id": "temporal-relations",
      "status": "bounded",
      "domain": "Bounded hopping expansion and revisable sessions over stored timestamps. No watermarks or wall-clock expiry.",
      "implementation": [
        "src/compiler/expansion.rs"
      ],
      "qualification": [
        "scripts/hopping_compiler_harness.py",
        "scripts/session_compiler_harness.py"
      ]
    },
    {
      "id": "composition",
      "status": "bounded",
      "domain": "Only bound derived scopes and compositions. Finalized aggregate types cross SQL boundaries; not arbitrary CTEs, recursion or subqueries.",
      "implementation": [
        "src/compiler/bind/derived.rs"
      ],
      "qualification": [
        "scripts/expression_composition_harness.py",
        "scripts/composition_matrix_harness.py",
        "scripts/native_cross_harness.py"
      ]
    },
    {
      "id": "binding-environment",
      "status": "bounded",
      "domain": "Catalog fingerprints/server version/settings bound on initialization/restart/rebuild. Cooperative maintenance revision fences coordinated changes; external timezone/locale files need operator attestation.",
      "implementation": [
        "src/semantics/catalog.sql",
        "src/semantics/maintenance.rs",
        "src/worker/results.rs"
      ],
      "qualification": [
        "scripts/query_binding_harness.py",
        "scripts/environment_harness.py"
      ]
    },
    {
      "id": "ordinary-result-table",
      "status": "bounded",
      "domain": "Typed result occurrences with original names/order/types/modifiers/collations. Bags permit only query-produced duplicates/NULLs; optional proven keys permit UPDATE. Atomic source progress and safe checkpoint-only ACK.",
      "implementation": [
        "src/catalog/memtable.rs",
        "src/catalog/sink.rs",
        "src/worker/checkpoint.rs"
      ],
      "qualification": [
        "scripts/result_table_harness.py",
        "scripts/keyed_sink_harness.py",
        "scripts/async_checkpoint_harness.py"
      ]
    }
  ],
  "error_contract": "Unavailable functions/overloads/shapes reject before activation. Valid queries can encounter runtime value/resource errors; preserve last complete sink/progress and never ACK the failing input. Native optimizer error order is not generally reproduced.",
  "qualification_scope": "References identify implementation/test ownership and explicit bounded evidence, not exhaustive proof over every input. Scalar closed-signature drift is checked by Rust; live scalar matrix covers all listed signatures and coercions through snapshot, CDC, NULLs, duplicates, retractions and restart.",
