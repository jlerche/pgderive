[postgres]
host=$postgres_host
port=5432
database="postgres"
user="supabase_admin"
tls="disable"
[replication]
slot=$slot
publication="pgderive_demo_sources"
[object_store]
endpoint=$endpoint
region="auto"
bucket=$bucket
credentials_file="/run/credentials/r2.json"
[execution]
cache_bytes=33554432
cache_entries=4096
resident_bytes=4194304
resident_entries=4096
record_bytes=65536
contributions=10000000
spill_runs=128
scratch_bytes=536870912
output_bytes=67108864
output_entries=250000
[worker]
catalog_schema=$schema
query_id=$query_id
sink_table=$table
sink_key=["product_id"]
object_prefix=$prefix
block_rows=4096
maintenance_ticks=16
memtable_bytes=33554432
checkpoint_interval_ms=5000
phase_metrics=true
retry_attempts=8
retry_delay_ms=250
startup_timeout_secs=180
max_transactions=0
[worker.query]
sql=$sql
