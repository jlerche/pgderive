{
  "name": "pgderive",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "pgderive.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/early-access"
    ]
  },
  "main": "worker.js",
  "d1_databases": [
    {
      "binding": "EARLY_ACCESS",
      "database_name": "pgderive-early-access",
      "database_id": "b30e8ed3-f917-45ed-ae5e-e356a1807169"
    }
  ],
  "ratelimits": [
    {
      "name": "SIGNUP_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
